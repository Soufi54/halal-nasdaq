# .env.muslimfinance.example
# Copie ce fichier en .env.muslimfinance et remplis les valeurs.
# Ces vars doivent aussi etre setup dans Cloudflare Pages :
#   Dashboard Cloudflare > Pages > halal-nasdaq > Settings > Environment variables > Production
# (Utiliser "Encrypt" pour tous les secrets, sauf STRIPE_PRICE_ID et SITE_URL.)

# ─── Stripe ────────────────────────────────────────────────────────────
# Clé secrète Stripe (mode TEST tant que non validé, LIVE quand pret)
STRIPE_SECRET_KEY=sk_test_XXX_ou_sk_live_XXX

# ID du prix precommande 29 EUR ebook halal-patrimoine-v2 (valable jusqu'au 21 juillet 2026)
# Test : price_1TXwH9BsN4944XVac3yU1zOl (existant a 14 EUR - a swap avec un nouveau price test 29 EUR)
# Live : a creer via Stripe Dashboard > Products > Halal & patrimoine v2 - Precommande (29 EUR)
# Note : creer aussi un 2eme price a 63 EUR pour la bascule post-21 juillet
STRIPE_PRICE_ID=price_XXXXXXXXXXXXXXXXXXX

# Webhook secret (voir Stripe Dashboard > Developers > Webhooks > endpoint /api/stripe/webhook > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Meta Conversion API ───────────────────────────────────────────────
META_PIXEL_ID=1986901548880799

# CAPI Access Token (voir Business Manager > Data Sources > Pixel > Settings > Set up manually > Conversions API > Generate access token)
META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx

# Optionnel: code de test event (a vider apres validation en prod)
META_TEST_EVENT_CODE=

# ─── Resend (email delivery) ───────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXX

# Sender email (verifier domaine muslimfinance.net dans Resend d'abord, ou utiliser backwatcher.app temporairement)
RESEND_FROM_EMAIL=guide@muslimfinance.net

# ─── Config site ───────────────────────────────────────────────────────
SITE_URL=https://muslimfinance.net

# URL directe du PDF ebook v2 (public sur Cloudflare Pages)
EBOOK_URL=https://muslimfinance.net/products/halal-patrimoine-v2.pdf

# ─── KV bindings ───────────────────────────────────────────────────────
# A creer dans Cloudflare Dashboard > Workers & Pages > KV > Create namespace
#   - SUBSCRIBERS_KV : deja existant (id = 6dc023e7db1540cf81bd2ad201413928)
#   - PURCHASES_KV   : a creer (nouvelle namespace)
# Puis lier dans halal-nasdaq Pages > Settings > Functions > KV namespace bindings :
#   SUBSCRIBERS_KV -> namespace existant
#   PURCHASES_KV   -> nouvelle namespace

# ─── Google Ads Conversion API (optionnel, phase 2) ────────────────────
# Voir doc Campagne SEA v1 - Tracking Setup pour details.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_CONVERSION_ACTION_ID=
